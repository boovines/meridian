# Live-service configuration: copy to .env.local only if it does not exist.
# Never commit the populated file. See README.md for the credential-free fixture path.
# Production must use Supabase Postgres. Local development defaults to PGlite.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_ARTIFACT_BUCKET=meridian-artifacts
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSL_ROOT_CERT=
# Hosted alternative: PEM contents of the trusted project CA, not a laptop path.
SUPABASE_DB_SSL_CA=
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.4-mini
OPENAI_SCOPING_MODEL=gpt-5.4-mini
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TLS=true
TEMPORAL_TASK_QUEUE=meridian-studio
VERCEL_OIDC_TOKEN=
OPENAI_ENGINEERING_MODEL=gpt-5.4-mini
OPENAI_RUNTIME_MODEL=gpt-5.4-mini

# Optional shared local inference-spend guard. Configure both; unknown outcomes
# retain reservations. Supports priced GPT-5.4 requests only; see app README.
# GPT-5.4 and the mini defaults above are supported at standard endpoint rates.
# This ledger is an estimate, not a provider billing limit; services:check bypasses it.
INFERENCE_BUDGET_USD=
INFERENCE_BUDGET_LEDGER=

# Hosted reads of verified copies of historical local artifacts only:
LOCAL_ARTIFACT_READ_BACKEND=

# Optional Judgment tracing. Use an organization ingest key (jli_), never an OAuth token.
JUDGMENT_API_KEY=
JUDGMENT_ORG_ID=bd6bb705-d647-45c9-ba5f-11e18ffe40fc
JUDGMENT_ENVIRONMENT=development
